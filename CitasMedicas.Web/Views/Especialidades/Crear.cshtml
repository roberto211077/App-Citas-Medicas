@model CitasMedicas.Web.Modules.CatalogoMedico.CrearEspecialidad.CrearEspecialidadRequest
@{
    ViewData["Title"] = "Crear especialidad";
}

<section class="specialties-page form-page">
    <a class="back-link" asp-controller="Especialidades" asp-action="Index">← Volver a especialidades</a>
    <div class="page-heading">
        <p class="eyebrow">CATÁLOGO DE LA CLÍNICA</p>
        <h1>Crear especialidad</h1>
        <p class="page-intro">Completá los datos para agregar una nueva opción al catálogo.</p>
    </div>

    <form asp-controller="Especialidades" asp-action="Crear" method="post" class="specialty-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-field">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-input" autocomplete="off" maxlength="100" placeholder="Ej.: Cardiología" />
            <span asp-validation-for="Nombre" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" class="form-input form-textarea" rows="4" maxlength="300" placeholder="Contá brevemente qué tipo de atención ofrece."></textarea>
            <span asp-validation-for="Descripcion" class="field-error"></span>
        </div>
        <div class="form-actions">
            <a class="secondary-link" asp-controller="Especialidades" asp-action="Index">Cancelar</a>
            <button type="submit" class="submit-button">Guardar especialidad</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
