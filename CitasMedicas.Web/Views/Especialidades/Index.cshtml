@model IReadOnlyList<CitasMedicas.Web.Modules.CatalogoMedico.ListarEspecialidades.Especialidad>
@{
    ViewData["Title"] = "Especialidades";
}

<section class="specialties-page">
    <div class="page-heading">
        <p class="eyebrow">CENTRO MÉDICO · TURNOS ONLINE</p>
        <h1>¿Qué atención necesitás?</h1>
        <p class="page-intro">Elegí una especialidad para ver las opciones de turnos disponibles.</p>
        <a class="primary-link" asp-controller="Especialidades" asp-action="Crear">+ Crear especialidad</a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="success-message" role="status">@mensaje</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state" role="status">
            <h2>Estamos preparando el catálogo</h2>
            <p>Por el momento no hay especialidades disponibles para reservar.</p>
        </div>
    }
    else
    {
        <ul class="specialty-list">
            @foreach (var especialidad in Model)
            {
                <li>
                    <a class="specialty-card" asp-controller="Especialidades" asp-action="BuscarTurnos" asp-route-id="@especialidad.Id" aria-label="Seleccionar @especialidad.Nombre y continuar con la búsqueda de turnos">
                        <span class="specialty-icon" aria-hidden="true">+</span>
                        <span class="specialty-copy">
                            <span class="specialty-name">@especialidad.Nombre</span>
                            <span class="specialty-description">@especialidad.Descripcion</span>
                        </span>
                        <span class="specialty-action">Seleccionar <span aria-hidden="true">→</span></span>
                    </a>
                </li>
            }
        </ul>
    }
</section>
