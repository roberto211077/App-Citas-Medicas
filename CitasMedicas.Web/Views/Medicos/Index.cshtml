@model IReadOnlyList<CitasMedicas.Web.Modules.CatalogoMedico.ListarEspecialidades.Medico>
@{
    ViewData["Title"] = "Médicos";
}

<section class="specialties-page">
    <div class="page-heading">
        <p class="eyebrow">CATÁLOGO DE LA CLÍNICA</p>
        <h1>Médicos</h1>
        <p class="page-intro">Consultá los médicos registrados y actualizá su información.</p>
        <a class="primary-link" asp-controller="Medicos" asp-action="Registrar">+ Registrar médico</a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="success-message" role="status">@mensaje</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state" role="status">
            <h2>No hay médicos registrados</h2>
            <p>Registrá un médico para poder administrar sus datos.</p>
            <a class="primary-link" asp-controller="Medicos" asp-action="Registrar">Registrar médico</a>
        </div>
    }
    else
    {
        <ul class="specialty-list">
            @foreach (var medico in Model)
            {
                <li>
                    <div class="specialty-card">
                        <span class="specialty-icon" aria-hidden="true">+</span>
                        <span class="specialty-copy">
                            <span class="specialty-name">@medico.Nombre</span>
                            <span class="specialty-description">@medico.Especialidad.Nombre</span>
                        </span>
                        <a class="specialty-action" asp-controller="Medicos" asp-action="Editar" asp-route-id="@medico.Id">Editar <span aria-hidden="true">→</span></a>
                    </div>
                </li>
            }
        </ul>
    }
</section>
